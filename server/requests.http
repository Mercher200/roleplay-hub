@baseUrl = http://localhost:3000/api


@token = 
@samToken = 

### 
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "gandalf",
  "password": "password123"
}

### 
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "sam",
  "password": "sam12345"
}

### Регистрация sam
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "sam",
  "email": "sam@example.com",
  "password": "sam12345"
}

### Профиль
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}

### Список комнат
GET {{baseUrl}}/rooms

### Вступить в комнату 1 (gandalf)
POST {{baseUrl}}/rooms/1/join
Authorization: Bearer {{token}}

### Вступить в комнату 1 (sam)
POST {{baseUrl}}/rooms/1/join
Authorization: Bearer {{samToken}}

### Список персонажей комнаты 1
GET {{baseUrl}}/characters?roomId=1

### 
POST {{baseUrl}}/characters
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": 1,
  "name": "Фродо",
  "race": "Хоббит",
  "class": "Вор",
  "hp": 18,
  "maxHp": 18,
  "strength": 8,
  "dexterity": 14,
  "intelligence": 12
}

### 
GET {{baseUrl}}/rooms/1/messages
Authorization: Bearer {{token}}

### 
# 
POST {{baseUrl}}/rooms/1/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Привет! Это тестовое сообщение с опечаткой."
}

### 
POST {{baseUrl}}/rooms/1/roll
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dice": "2d6+3"
}

### 
POST {{baseUrl}}/rooms/1/roll
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dice": "20d6"
}


### 
PUT {{baseUrl}}/rooms/1/messages/ВСТАВЬ_ID_СООБЩЕНИЯ
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Привет! Это тестовое сообщение БЕЗ опечатки."
}

### 
DELETE {{baseUrl}}/rooms/1/messages/ВСТАВЬ_ID_СООБЩЕНИЯ_GANDALF
Authorization: Bearer {{samToken}}

### 
DELETE {{baseUrl}}/rooms/1/messages/ВСТАВЬ_ID_СООБЩЕНИЯ
Authorization: Bearer {{token}}